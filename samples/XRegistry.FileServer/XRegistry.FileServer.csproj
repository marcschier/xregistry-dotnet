<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFrameworks />
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>XRegistry.Sample.FileServer</AssemblyName>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\XRegistry.AspNetCore\XRegistry.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\XRegistry.Storage.File\XRegistry.Storage.File.csproj" />
    <ProjectReference Include="..\..\src\XRegistry.Models\XRegistry.Models.csproj" />
    <Compile Include="..\Shared\RegistrySample*.cs" Link="Hosting\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
