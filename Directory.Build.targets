<Project>
  <PropertyGroup Condition="'$(NuGetLockFilePath)' == '' and ('$(RuntimeIdentifier)' != '' or '$(PublishAot)' == 'true')">
    <_XRegistryNativeLockProfile Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_XRegistryNativeLockProfile>
    <_XRegistryNativeLockProfile Condition="'$(_XRegistryNativeLockProfile)' == ''">aot</_XRegistryNativeLockProfile>
    <NuGetLockFilePath>$(MSBuildProjectExtensionsPath)native-$(_XRegistryNativeLockProfile).packages.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnablePackageValidation>true</EnablePackageValidation>
    <Description>Model-driven xRegistry client and server components for modern .NET.</Description>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)NOTICE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
